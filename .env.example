# ──────────────────────────────────────────────────────────────────────────────
# Ecommerce Platform — Environment Configuration
# Copy this file to .env and fill in your values before running docker compose.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=changeme

# Keycloak admin console password  (http://localhost:8180)
KEYCLOAK_ADMIN_PASSWORD=changeme

# Keycloak service-account secret — matches the bundled realm-export.json.
# Change this if you re-export the realm with a different secret.
USER_SERVICE_ADMIN_CLIENT_SECRET=dev-user-service-admin-secret

# Iyzico payment gateway (https://merchant.iyzipay.com → Settings → API keys)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Iyzico callback URL — the public address that Iyzico POSTs payment results to.
# For local development this must be a publicly reachable URL (use a tunnel like ngrok).
# On a server replace with your domain or public IP:
#   http://YOUR_SERVER_IP/api/payments/callback
IYZICO_CALLBACK_URL=http://localhost/api/payments/callback
